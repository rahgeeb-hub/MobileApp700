<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- This displays the settings heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="30dp" />

    <!-- This turns expiry alerts on or off -->
    <Switch
        android:id="@+id/switchExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiring Soon Alerts"
        android:textSize="18sp" />

    <!-- This explains the expiry alert setting -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show an alert for pantry items that are expiring soon."
        android:textSize="15sp"
        android:layout_marginTop="10dp" />

</LinearLayout>